{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "isla-desk",
  "version": "0.1.0",
  "identifier": "com.royhan.isladesk",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "island",
        "title": "isla-desk",
        "width": 760,
        "height": 420,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false
      },
      {
        "label": "settings",
        "title": "Isla Desk",
        "width": 920,
        "height": 720,
        "minWidth": 360,
        "minHeight": 480,
        "center": true,
        "visible": false
      },
      {
        "label": "review",
        "title": "Isla Desk - Review",
        "width": 640,
        "height": 560,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
