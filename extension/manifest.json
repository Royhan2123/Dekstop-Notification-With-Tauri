{
  "manifest_version": 3,
  "name": "Isla Link",
  "version": "0.2.0",
  "description": "Hubungkan browser ke Isla Desk: tampilkan lagu yang diputar, kontrol dari pulau, atur kecepatan, dan cari lagu.",
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": ["ws://127.0.0.1/*"],
  "background": {
    "service_worker": "dist/background.js",
    "scripts": ["dist/background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://music.youtube.com/*"],
      "js": ["dist/content-youtube.js"]
    },
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://music.youtube.com/*",
        "*://open.spotify.com/*",
        "*://soundcloud.com/*",
        "*://www.deezer.com/*",
        "*://listen.tidal.com/*"
      ],
      "js": ["dist/content-media.js"]
    }
  ],
  "action": { "default_popup": "popup.html" },
  "browser_specific_settings": { "gecko": { "id": "isla-link@isla-desk.app" } }
}
